rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // users/{uid} - one profile per borrower, owned by that borrower.
    // The Profile screen updates firstName, lastName, rfidCardUid and
    // notificationsEnabled; nothing else in the app touches it after sign-up.
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isMe(userId);
      allow create: if isMe(userId);
      allow update: if isMe(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // equipment/{boxId} - one document per SmartDock box.
    // Any signed-in borrower can read availability (FR-10). Writes are limited
    // to the two state transitions the app (or the tower) performs, and the
    // shapes below mirror LoanPolicy.borrowUpdate() / returnUpdate() exactly.
    // ------------------------------------------------------------------
    match /equipment/{boxId} {
      function incoming() { return request.resource.data; }
      function current() { return resource.data; }

      function staticFieldsUnchanged() {
        return incoming().name == current().name
          && incoming().category == current().category
          && incoming().boxNumber == current().boxNumber;
      }

      // available -> borrowed by the caller, with a due time after the borrow time.
      function isBorrow() {
        return current().status == 'available'
          && incoming().status == 'borrowed'
          && incoming().borrowedBy == request.auth.uid
          && incoming().borrowedByName is string
          && incoming().borrowedAt is int && incoming().borrowedAt > 0
          && incoming().dueAt is int && incoming().dueAt > incoming().borrowedAt
          && staticFieldsUnchanged();
      }

      // borrowed by the caller -> available, with every loan field cleared.
      function isReturn() {
        return current().status == 'borrowed'
          && current().borrowedBy == request.auth.uid
          && incoming().status == 'available'
          && incoming().borrowedBy == ''
          && incoming().borrowedByName == ''
          && incoming().borrowedAt == 0
          && incoming().dueAt == 0
          && staticFieldsUnchanged();
      }

      allow read: if signedIn();

      // Seeding the sample boxes: only brand-new, available documents.
      allow create: if signedIn()
        && incoming().name is string && incoming().name.size() > 0
        && incoming().category is string
        && incoming().boxNumber is int && incoming().boxNumber > 0
        && incoming().status == 'available'
        && incoming().borrowedBy == ''
        && incoming().borrowedByName == ''
        && incoming().borrowedAt == 0
        && incoming().dueAt == 0;

      allow update: if signedIn() && (isBorrow() || isReturn());
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // transactions/{autoId} - append-only borrow / return log.
    // A borrower only ever reads their own rows (the app queries
    // whereEqualTo("uid", auth.uid), which satisfies the read rule).
    // ------------------------------------------------------------------
    match /transactions/{txnId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['borrow', 'return']
        && request.resource.data.equipmentId is string
        && request.resource.data.boxNumber is int
        && request.resource.data.timestamp is int;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // notifications/{id} - the borrower's inbox (borrow/return confirmations
    // and due-soon / overdue reminders). Created unread; the only later change
    // allowed is flipping `read` to true.
    // ------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.type in ['borrow', 'return', 'due_soon', 'overdue']
        && request.resource.data.createdAt is int;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if false;
    }
  }
}
