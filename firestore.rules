rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isMe(userId);
      allow create: if isMe(userId);
      allow update: if isMe(userId)
        && request.resource.data.uid == userId;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // equipment/{boxId}
    // ------------------------------------------------------------------
    match /equipment/{boxId} {
      function incoming() { return request.resource.data; }
      function current()  { return resource.data; }

      function staticFieldsUnchanged() {
        return incoming().name       == current().name
            && incoming().category   == current().category
            && incoming().boxNumber  == current().boxNumber;
      }

      // available -> borrowed by the caller.
      // borrowedAt / dueAt are epoch-millisecond Longs — use `is number` not `is int`.
      function isBorrow() {
        return current().status      == 'available'
            && incoming().status     == 'borrowed'
            && incoming().borrowedBy == request.auth.uid
            && incoming().borrowedByName is string
            && incoming().borrowedAt is number && incoming().borrowedAt > 0
            && incoming().dueAt      is number && incoming().dueAt > incoming().borrowedAt
            && staticFieldsUnchanged();
      }

      // borrowed by the caller -> available, all loan fields cleared to 0.
      function isReturn() {
        return current().status      == 'borrowed'
            && current().borrowedBy  == request.auth.uid
            && incoming().status     == 'available'
            && incoming().borrowedBy == ''
            && incoming().borrowedByName == ''
            && incoming().borrowedAt == 0
            && incoming().dueAt      == 0
            && staticFieldsUnchanged();
      }

      allow read:   if signedIn();
      allow create: if signedIn()
        && incoming().name       is string && incoming().name.size() > 0
        && incoming().category   is string
        && incoming().boxNumber  is number && incoming().boxNumber > 0
        && incoming().status     == 'available'
        && incoming().borrowedBy == ''
        && incoming().borrowedByName == ''
        && incoming().borrowedAt == 0
        && incoming().dueAt      == 0;
      allow update: if signedIn() && (isBorrow() || isReturn());
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // transactions/{autoId}
    // timestamp is epoch-millis Long — use `is number` not `is int`.
    // ------------------------------------------------------------------
    match /transactions/{txnId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid         == request.auth.uid
        && request.resource.data.type        in ['borrow', 'return']
        && request.resource.data.equipmentId is string
        && request.resource.data.boxNumber   is number
        && request.resource.data.timestamp   is number;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // notifications/{id}
    // createdAt is epoch-millis Long — use `is number` not `is int`.
    // ------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid       == request.auth.uid
        && request.resource.data.read      == false
        && request.resource.data.type      in ['borrow', 'return', 'due_soon', 'overdue']
        && request.resource.data.createdAt is number;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if false;
    }
  }
}
