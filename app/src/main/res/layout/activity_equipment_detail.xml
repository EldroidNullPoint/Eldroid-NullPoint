<?xml version="1.0" encoding="utf-8"?><!--
    Detail for one SmartDock box. Covers FR-05 (item name, borrow time, return time,
    box location) with a live listener, plus a Borrow / Return action that stands in
    for the RFID tap at the tower while the hardware is being built. Exactly one of
    the two buttons is shown, and only when the action is valid for this borrower.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".EquipmentDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_back" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_thumbnail"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/DetailPhotoShape"
            tools:src="@drawable/equip_projector" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Epson LCD Projector" />

        <TextView
            android:id="@+id/tvStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_available"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/brand_dark_green"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Available" />

        <!-- What the borrower has to do at the tower, per the current status -->
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_muted"
            android:drawablePadding="12dp"
            android:drawableStart="@drawable/ic_box"
            android:gravity="center_vertical"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="Tap your RFID card on the SmartDock tower, then take it from Box 1." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/rowCategory"
            style="@style/DetailRow">

            <TextView
                style="@style/DetailRowLabel"
                android:text="@string/detail_category" />

            <TextView
                android:id="@+id/tvCategory"
                style="@style/DetailRowValue"
                tools:text="Audio Visual" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">

            <TextView
                style="@style/DetailRowLabel"
                android:text="@string/detail_box" />

            <TextView
                android:id="@+id/tvBox"
                style="@style/DetailRowValue"
                tools:text="Box 1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowHolder"
            style="@style/DetailRow"
            tools:visibility="visible">

            <TextView
                style="@style/DetailRowLabel"
                android:text="@string/detail_holder" />

            <TextView
                android:id="@+id/tvHolder"
                style="@style/DetailRowValue"
                tools:text="You" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowBorrowedAt"
            style="@style/DetailRow">

            <TextView
                style="@style/DetailRowLabel"
                android:text="@string/detail_borrowed_at" />

            <TextView
                android:id="@+id/tvBorrowedAt"
                style="@style/DetailRowValue"
                tools:text="Sep 10, 9:12 AM" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDueAt"
            style="@style/DetailRow">

            <TextView
                style="@style/DetailRowLabel"
                android:text="@string/detail_due_at" />

            <TextView
                android:id="@+id/tvDueAt"
                style="@style/DetailRowValue"
                tools:text="Sep 10, 3:12 PM" />
        </LinearLayout>

        <!-- ============ Borrow / Return / Extension actions ============ -->
        <LinearLayout
            android:id="@+id/actionArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnBorrow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/selector_button_primary"
                    android:elevation="0dp"
                    android:text="@string/btn_borrow"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btnReturn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/selector_button_primary"
                    android:elevation="0dp"
                    android:text="@string/btn_return"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressAction"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand_green"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Spec §15: Extension request button — shown when borrower owns the active loan -->
            <Button
                android:id="@+id/btnRequestExtension"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_muted"
                android:elevation="0dp"
                android:text="@string/btn_request_extension"
                android:textAllCaps="false"
                android:textColor="@color/brand_dark_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/action_stand_in_note"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
