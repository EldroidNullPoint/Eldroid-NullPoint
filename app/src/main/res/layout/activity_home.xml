<?xml version="1.0" encoding="utf-8"?><!--
    Borrower dashboard. Read-only monitoring surface for the SmartDock tower:
    greeting, current borrowing status, equipment availability, the borrower's own
    items and their recent activity. There is deliberately no "Borrow" action here -
    borrowing and returning happen physically at the tower via RFID.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".HomeActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- ============ Header / greeting ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Good morning, Bryce" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/dashboard_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivRefresh"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_refresh"
                    android:padding="7dp"
                    android:src="@drawable/ic_refresh" />

                <ImageView
                    android:id="@+id/ivChangePassword"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_change_password"
                    android:padding="7dp"
                    android:src="@drawable/ic_shield_lock" />

                <ImageView
                    android:id="@+id/ivLogout"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_logout"
                    android:padding="7dp"
                    android:src="@drawable/ic_logout" />
            </LinearLayout>

            <!-- ============ Error state ============ -->
            <LinearLayout
                android:id="@+id/errorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_overdue"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:drawableStart="@drawable/ic_alert"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/error_load_dashboard"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:text="@string/btn_retry"
                    android:textColor="@color/brand_dark_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ============ Loading state ============ -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/brand_green"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- ============ Everything below is hidden until first load ============ -->
            <LinearLayout
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!--
                    Shown only when users/{uid}.rfidCardUid is empty. Without a
                    registered card the borrower cannot open a session at the tower
                    (FR-01), so it is worth saying so up front rather than letting
                    them discover it at the reader.
                -->
                <LinearLayout
                    android:id="@+id/rfidWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill_due_soon"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alert" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/rfid_card_missing"
                            android:textColor="@color/warning_amber"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/rfid_card_missing_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- == Current borrowing status == -->
                <TextView
                    style="@style/DashboardSectionTitle"
                    android:layout_marginTop="26dp"
                    android:text="@string/section_current_status" />

                <!-- Active item hero card -->
                <LinearLayout
                    android:id="@+id/cardCurrentItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivCurrentPhoto"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:background="@drawable/bg_thumbnail_light"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/EquipmentThumbnailShape"
                            tools:src="@drawable/equip_projector" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCurrentName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="2"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Epson LCD Projector" />

                            <TextView
                                android:id="@+id/tvCurrentBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.75"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                tools:text="Box 3  ·  Audio Visual" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCurrentStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill_available"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/brand_dark_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Due in 3h 20m" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:alpha="0.2"
                        android:background="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:text="@string/label_borrowed_at"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tvCurrentBorrowedAt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                tools:text="Sep 10, 9:12 AM" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:text="@string/label_due_at"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textAllCaps="true" />

                            <TextView
                                android:id="@+id/tvCurrentDueAt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                tools:text="Sep 10, 3:12 PM" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Nothing borrowed empty state -->
                <LinearLayout
                    android:id="@+id/emptyCurrentItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_muted"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_inbox_empty" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_current_status"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/empty_current_status_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- == My borrowed items (only shown when more than one) == -->
                <TextView
                    android:id="@+id/titleMyItems"
                    style="@style/DashboardSectionTitle"
                    android:layout_marginTop="26dp"
                    android:text="@string/section_my_items"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMyItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_equipment" />

                <!-- == Equipment availability == -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/DashboardSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/section_equipment" />

                    <TextView
                        android:id="@+id/btnSeeAllEquipment"
                        style="@style/SeeAllButton" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvailableCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="7 of 10 available" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEquipment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_equipment" />

                <TextView
                    android:id="@+id/tvEmptyEquipment"
                    style="@style/DashboardEmptyText"
                    android:text="@string/empty_equipment"
                    android:visibility="gone" />

                <!-- == Recent activity == -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/DashboardSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/section_activity" />

                    <TextView
                        android:id="@+id/btnSeeAllActivity"
                        style="@style/SeeAllButton" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_transaction" />

                <TextView
                    android:id="@+id/tvEmptyActivity"
                    style="@style/DashboardEmptyText"
                    android:text="@string/empty_activity"
                    android:visibility="gone" />

                <!-- == RFID explainer: the phone never performs the checkout == -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_card_muted"
                    android:drawablePadding="12dp"
                    android:drawableStart="@drawable/ic_box"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="3dp"
                    android:padding="16dp"
                    android:text="@string/rfid_notice"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
