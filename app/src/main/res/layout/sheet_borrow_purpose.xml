<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom sheet shown when the user taps Borrow.
    Collects the borrower's stated purpose before committing the loan.
    Also shows the 3-hour rule and extension note clearly.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="32dp"
    android:background="@color/white">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_pill_neutral"
        android:alpha="0.4" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sheet_borrow_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Equipment name -->
    <TextView
        android:id="@+id/tvSheetEquipmentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_green"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"
        tools:text="Epson LCD Projector" />

    <!-- Box and due time info -->
    <TextView
        android:id="@+id/tvSheetBoxDue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"
        tools:text="Box 1  ·  Due back in 3 hours" />

    <!-- Policy reminder card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_muted"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sheet_borrow_policy_heading"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sheet_borrow_policy_body"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Purpose input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_purpose_required"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPurpose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_purpose"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:lines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm button -->
    <Button
        android:id="@+id/btnSheetConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/selector_button_primary"
        android:elevation="0dp"
        android:text="@string/btn_confirm_borrow"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Cancel link -->
    <Button
        android:id="@+id/btnSheetCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:text="@string/btn_cancel"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
