<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!--
        Borrow/return rows show the equipment photo; overdue and alert rows keep the
        warning icon instead, so the warning stays unmistakable. Set up at runtime.
    -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivActivityIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_thumbnail"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/EquipmentThumbnailShape"
        tools:src="@drawable/equip_microphone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActivityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="Borrowed Wireless Microphone Set" />

        <TextView
            android:id="@+id/tvActivityMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Box 2  ·  Sep 10, 9:12 AM" />
    </LinearLayout>

</LinearLayout>
